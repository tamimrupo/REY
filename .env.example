# Supabase — copy this file to .env.local and paste your project keys.
# Supabase dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used for auth email redirects (confirmation + password reset) and metadata.
# In production this is your real domain, e.g. https://reybd.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
