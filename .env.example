# =============================================================================
# REY BD — environment template
# Copy to .env.local and fill in. On Vercel, add the same values as env vars.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Dashboard → your project → "Connect", or Project Settings → API.
# The client key may be labelled "publishable" (sb_publishable_…) OR "anon"
# (a long eyJ… token). Either works. NEVER put the service_role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Used for auth email redirects (sign-up confirmation + password reset) and for
# metadata. In production this is your real domain, e.g. https://reybd.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (optional, but recommended) ---------------------------------------
# Two separate jobs:
#   1. Sign-up confirmation and password-reset emails are sent BY SUPABASE.
#      Configure those under Authentication → Emails → SMTP settings in the
#      Supabase dashboard (Brevo works well). That is NOT this file.
#   2. Renewal reminders / dispatch messages from the admin outbox are sent by
#      this app, using one of the providers below.
#
# Brevo (recommended): dashboard → SMTP & API → API Keys.
# BREVO_SENDER_EMAIL must be a verified sender/domain in Brevo.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=hello@yourdomain.com
# BREVO_SENDER_NAME=REY BD

# Resend alternative:
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=REY BD <hello@yourdomain.com>

# --- Cron (needed on Vercel) -------------------------------------------------
# Daily maintenance expires finished plans and queues renewal reminders.
# Copy the value from the admin dashboard → Settings → Daily maintenance.
# CRON_SECRET=

# --- Book metadata (optional) ------------------------------------------------
# The admin "Search a book" screen reads Open Library, which needs no key and is
# the only source used by default.
# Google Books has richer descriptions but its anonymous quota is exhausted
# within minutes (HTTP 429), so it is only consulted when a key is present.
# Free key: console.cloud.google.com → enable "Books API" → Credentials.
# GOOGLE_BOOKS_API_KEY=
